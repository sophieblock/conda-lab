{
  "servers": {
    "github-mcp-server": {
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "X-MCP-Toolsets": "default,orgs"
      },
      "type": "http"
    },
    "github-actions": {
      "url": "https://api.githubcopilot.com/mcp/x/actions",
      "type": "http"
    },
    "github-context": {
      "url": "https://api.githubcopilot.com/mcp/x/context",
      "type": "http"
    },
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time",
        "--local-timezone",
        "America/New_York"
      ],
      "type": "stdio"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "type": "stdio"
    }
  },
  "inputs": []
}
